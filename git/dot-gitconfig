[user]
    name = Alvin Shen
    email = 29553973+alven-shin@users.noreply.github.com

[init]
    defaultBranch = main

[pull]
    ff = only

[push]
    autoSetupRemote = true

[alias]
    a = add
    aa = add .
    s = status
    ss = status --short
    c = commit
    cv = commit --verbose
    cva = commit --verbose --amend
    d = diff
    ds = diff --staged
    p = push
    hist = log --pretty=format:'%C(yellow)%h%Creset %C(green)%ad%Creset | %Creset%s%C(auto)%d%Creset [%C(blue)%an%Creset]' --graph --date=short
    b = branch
    ch = checkout
    sw = switch
    nbc = clone --filter=blob:none

[core]
    excludesfile = ~/.gitignore_global
    pager = delta

[interactive]
    diffFilter = delta --color-only --features=interactive

[delta]
    navigate = true    # use n and N to move between diff sections
    side-by-side = true

    # delta detects terminal colors automatically; set one of these to disable auto-detection
    # dark = true
    light = true

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default
